BOT_TOKEN=your_bot_token_here
BOT_USERNAME=SnakeArenaBot
DATABASE_URL=postgresql://user:password@host:5432/database
# DB_SSL=false only for a local PostgreSQL without TLS. Render Postgres can use the default SSL setting.

# Необязательно: короткое имя Mini App из BotFather (/newapp) -> ссылки t.me/bot/app?startapp=ref_ID
# APP_SHORT_NAME=play
# Награды за приглашение (по умолчанию 500 пригласившему, 200 приглашённому)
# REF_REWARD=500
# REF_BONUS=200

# Часовой пояс для «нового дня» ежедневной награды (по умолчанию UTC)
# DAILY_TZ=Europe/Moscow
