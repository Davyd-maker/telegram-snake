BOT_TOKEN=your_bot_token_here
BOT_USERNAME=SnakeArenaBot
DATABASE_URL=postgresql://user:password@host:5432/database
# DB_SSL=false only for a local PostgreSQL without TLS. Render Postgres can use the default SSL setting.

# Необязательно: короткое имя Mini App из BotFather (/newapp) -> ссылки t.me/bot/app?startapp=ref_ID
# APP_SHORT_NAME=play
# Награды за приглашение (по умолчанию 500 пригласившему, 200 приглашённому)
# REF_REWARD=500
# REF_BONUS=200

# Часовой пояс для «нового дня» ежедневной награды (по умолчанию UTC)
# DAILY_TZ=Europe/Moscow

# --- Telegram Stars (эпические скины) и бот ---
# Публичный адрес сервиса. На Render подставляется сам (RENDER_EXTERNAL_URL); вне Render укажи вручную.
# По нему сервер ставит вебхук бота: без него оплата Stars не завершится.
# PUBLIC_URL=https://snake-arena.onrender.com
# Напоминания о серии от бота: REMINDERS=off — выключить; REMINDER_HOUR — с какого часа (по DAILY_TZ) слать
# REMINDERS=on
# REMINDER_HOUR=18

# --- Рефералы ---
# REF_MODE=start      # по умолчанию: t.me/бот?start=ref_ID (нужен вебхук, т.е. PUBLIC_URL)
# REF_MODE=startapp   # t.me/бот?startapp=ref_ID — только если у бота настроено «основное Mini App» в BotFather
# BOT_USERNAME можно не задавать: сервер определит его сам через getMe

# --- Админка ---
# Telegram ID владельца/администратора. Можно указать несколько через запятую.
ADMIN_TELEGRAM_ID=123456789

# --- Защита и челлендж дня ---
# Сколько секунд принимается подпись Telegram (initData). По умолчанию сутки.
# INITDATA_MAX_AGE=86400
# Монет за первый забег ежедневного челленджа
# DAILY_CHALLENGE_BONUS=150
# Пауза между сообщениями рассылки из админки, мс (лимит Telegram ~30 сообщений/сек)
# BROADCAST_DELAY_MS=45

# --- v28 ---
# Redis для общих лимитов запросов, если запущено несколько экземпляров сервера (redis:// или rediss://)
# REDIS_URL=redis://default:password@host:6379
# Сообщений от бота одному игроку в сутки (друг побил рекорд и т. п.)
# NOTIFY_MAX_PER_DAY=3
# Двойные монеты по выходным (off — выключить)
# WEEKEND_X2=on
# Вечерняя сводка админу: час по DAILY_TZ; ADMIN_SUMMARY=off — выключить
# SUMMARY_HOUR=21
# Античит: порог «идеальности» пути (меньше — подозрительнее) и минимум данных
# AC_EFF_FLAG=1.1
# AC_MIN_DIST=200
# Новость обновления: после выкладки новой версии бот один раз рассылает «что нового» (текст — src/changelog.js).
# off — не рассылать автоматически (разослать можно вручную: админка → «Рассылка»)
# ANNOUNCE_UPDATES=on
