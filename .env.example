BOT_TOKEN=your_bot_token_here
BOT_USERNAME=SnakeArenaBot
DATABASE_URL=postgresql://user:password@host:5432/database
# DB_SSL=false only for a local PostgreSQL without TLS. Render Postgres can use the default SSL setting.

# Необязательно: короткое имя Mini App из BotFather (/newapp) -> ссылки t.me/bot/app?startapp=ref_ID
# APP_SHORT_NAME=play
# Награды за приглашение (по умолчанию 500 пригласившему, 200 приглашённому)
# REF_REWARD=500
# REF_BONUS=200

# Часовой пояс для «нового дня» ежедневной награды (по умолчанию UTC)
# DAILY_TZ=Europe/Moscow

# --- Telegram Stars (эпические скины) и бот ---
# Публичный адрес сервиса. На Render подставляется сам (RENDER_EXTERNAL_URL); вне Render укажи вручную.
# По нему сервер ставит вебхук бота: без него оплата Stars не завершится.
# PUBLIC_URL=https://snake-arena.onrender.com
# Напоминания о серии от бота: REMINDERS=off — выключить; REMINDER_HOUR — с какого часа (по DAILY_TZ) слать
# REMINDERS=on
# REMINDER_HOUR=18

# --- Рефералы ---
# REF_MODE=start      # по умолчанию: t.me/бот?start=ref_ID (нужен вебхук, т.е. PUBLIC_URL)
# REF_MODE=startapp   # t.me/бот?startapp=ref_ID — только если у бота настроено «основное Mini App» в BotFather
# BOT_USERNAME можно не задавать: сервер определит его сам через getMe
